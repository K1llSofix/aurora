{
  "name": "aurora-launcher",
  "productName": "Aurora Launcher",
  "version": "1.1.1",
  "description": "Лаунчер Minecraft с клиентом Aurora",
  "main": "src/main/main.js",
  "author": "K1llSofix",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "python scripts/make-icon.py",
    "dist": "node scripts/prepare-mod.js && electron-builder --win nsis --x64 && node scripts/update-info.js",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.aurora.launcher",
    "productName": "Aurora Launcher",
    "copyright": "© 2026 K1llSofix",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "CHANGELOG.md",
      "src/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "resources/mods",
        "to": "mods",
        "filter": [
          "*.jar",
          "CHANGELOG.md"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "AuroraLauncher"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aurora Launcher",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "AuroraLauncher-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  }
}
